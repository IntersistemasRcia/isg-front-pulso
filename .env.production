# Entorno de producción (cargado por `next build` / `next start`)
# Front y API Auth en el mismo servidor Windows → URL local
AUTH_API_URL=http://localhost:8601

# Secreto de firma JWT de API Auth (obligatorio en prod para verificar HS512)
JWT_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LOCAL_AGENT_URL=http://localhost:5100
LOCAL_AGENT_API_KEY=change-me-agent-key

NEXT_PUBLIC_API_URL=
