# Plantilla de variables. Next.js carga automÃ¡ticamente:
#   - `.env.development` con `npm run dev`  (API Auth de test)
#   - `.env.production`  con `npm run build` / `npm start` (API local same-server)
#   - `.env.local`       overrides locales (gitignored; secretos)

# API Auth
# Test:    http://api.intersistemas.ar:8601
# Prod:    http://localhost:8601  (mismo servidor que el front)
AUTH_API_URL=http://api.intersistemas.ar:8601

# Endpoint usado por el proxy: POST {AUTH_API_URL}/api/Auth/Login
# Body: { "usuario": "...", "password": "..." }
# Response: { "token": "...", "validTo": "..." }

# Secreto HS512 de API Auth (recomendado en prod; en test puede omitirse)
JWT_SECRET=

# Fallback local SOLO si AUTH_API_URL estÃ¡ vacÃ­o
LOCAL_AUTH_USER=demo
LOCAL_AUTH_PASSWORD=demo

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Multi-LLM — tier free (obligatorio para que aparezca Gemini en el combo)
# Obtener en: https://aistudio.google.com/apikey
GOOGLE_FREE_API_KEY=
# Opcional: backup free con GPT-OSS 120B vía Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Premium por empresa (alternativa a BYOK por usuario)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=AQ.Ab8RN6IyDH6PuamXASOsmTQOXZ4_-RuSDh1bU5DvC1No3NLGNw

# Cifrado AES-256-GCM de claves BYOK en data/byok/
BYOK_ENCRYPTION_KEY=


# isg-api-pulso (.NET 10)
NEXT_PUBLIC_PULSO_API_URL=https://localhost:44351/api/v1/pulso
# PULSO_API_URL=https://localhost:44351/api/v1/pulso
# PULSO_API_TOKEN=   # opcional; por defecto se usa el JWT de la sesiÃ³n
# PULSO_TLS_INSECURE=1  # solo local con certificado autofirmado

LOCAL_AGENT_URL=http://localhost:5100
LOCAL_AGENT_API_KEY=change-me-agent-key

NEXT_PUBLIC_API_URL=
