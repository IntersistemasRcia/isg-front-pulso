# URL base de la API Auth existente (on-premise / relativa)
AUTH_API_URL=http://localhost:5000

# Secreto / clave pública para validar JWT emitido por API_Auth
JWT_SECRET=change-me-in-production

# OpenAI (orquestador /api/chat)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Agente local .NET del cliente (ejecutor de SPs)
LOCAL_AGENT_URL=http://localhost:5100
LOCAL_AGENT_API_KEY=change-me-agent-key

# Cliente HTTP del browser (opcional; por defecto usa rutas relativas /api)
NEXT_PUBLIC_API_URL=
